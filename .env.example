# Copy to .env and change for your machine. Never commit .env.
# Loaded automatically by `docker compose up`.

# --- PostgreSQL superuser (database container + migrations) ---
POSTGRES_USER=pgs
POSTGRES_PASSWORD=pgs
POSTGRES_DB=pgs
POSTGRES_PORT=5432

# --- Per-role passwords created by the Allembic migrations ---
# (set on roles by the one-shot db-role-passwords service)
PGS_API_DB_PASSWORD=pgs_api_dev
PGS_ETL_DB_PASSWORD=pgs_etl_dev
PGS_SEARCH_DB_PASSWORD=pgs_search_dev
PGS_SCRAPER_DB_PASSWORD=pgs_scraper_dev

# --- OpenSearch ---
OPENSEARCH_INDEX=np_web_pages

# --- Kafka / scraper ---
KAFKA_TOPIC=crawled-documents
SCRAPER_STORAGE=kafka          # ndjson | postgres | kafka
SCRAPER_MAX_CONCURRENT=32

# --- UI (baked into the Next.js bundle at build time) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_SECRET_KEY=dummy_dev_secret_change_me
