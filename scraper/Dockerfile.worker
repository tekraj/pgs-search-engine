# syntax=docker/dockerfile:1
FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
# CGO_ENABLED=0 for a fully static binary -- required for the distroless
# base below, which has no libc.
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

# distroless/static: no shell, no package manager, just the binary and CA
# certs (needed for the worker's outbound HTTPS fetches during a crawl).
# Smaller attack surface than alpine for a container that spends its life
# talking to arbitrary third-party sites.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/worker /worker
EXPOSE 9090
ENTRYPOINT ["/worker"]
